# Project Planner route managed by VPS-Gateway. Certbot may extend this file.
server {
    listen 80;
    listen [::]:80;
    server_name __HOSTNAME__;
    server_tokens off;
    client_max_body_size 25m;
    access_log /var/log/nginx/access.log vps_gateway;
    auth_basic "Project Planner";
    auth_basic_user_file /etc/nginx/project-planner-__HOSTNAME__.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }
}
