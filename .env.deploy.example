# Copy to .env.deploy, fill in values, then chmod 600 .env.deploy.
DEPLOY_HOST=217.160.255.49
DEPLOY_TARGET=production
DEPLOY_USER=root
DEPLOY_SSH_PORT=22
DEPLOY_IDENTITY_FILE=
DEPLOY_HOSTNAME=project-planner.portfolio-finke.de
DEPLOY_ROOT=/root/project-planner
DEPLOY_WEB_PORT=18084
DEPLOY_WEB_AUTH=none
# To require a browser login, set DEPLOY_WEB_AUTH=basic and provide:
# DEPLOY_WEB_USERNAME=planner
# DEPLOY_WEB_PASSWORD=replace-with-a-long-random-password
# DNS must point to the server and ports 80/443 must be reachable.
DEPLOY_TLS_EMAIL=admin@example.org
