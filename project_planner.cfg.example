[database]
# Environment override: PROJECT_PLANNER_DB
path = ~/.project_planner/project_planner.sqlite3
# Optional database-agnostic SQLAlchemy URL; overrides path when non-empty.
# Environment override: PROJECT_PLANNER_DB_URL
url =

[window]
# Environment overrides: PROJECT_PLANNER_WINDOW_WIDTH / PROJECT_PLANNER_WINDOW_HEIGHT /
# PROJECT_PLANNER_FULLSCREEN
width = 1280
height = 800
fullscreen = true

[editor]
# Environment override: PROJECT_PLANNER_AUTOSAVE_SECONDS
autosave_seconds = 20

[ui]
# Environment override: PROJECT_PLANNER_UI_SCALE
# auto uses 1.00 at 1920x1080 or larger and 2.00 for the 1280x800 laptop profile.
# A numeric value from 0.05 through 5.00 overrides automatic scaling.
scale = auto

[storage]
# Environment override: PROJECT_PLANNER_DATA_DIR
data_directory = ~/.project_planner/data
# Environment override: PROJECT_PLANNER_MAX_IMAGE_BYTES
max_image_bytes = 20971520
# Maximum total unpacked archive bytes (8 GiB by default).
# Environment override: PROJECT_PLANNER_MAX_BACKUP_UNCOMPRESSED_BYTES
max_backup_uncompressed_bytes = 8589934592

[api]
# Optional remote API base including /api/v1. Empty starts the embedded localhost API.
# Environment override: PROJECT_PLANNER_API_URL
url =
# Comma-separated browser origins permitted by a separately hosted API.
# Environment override: PROJECT_PLANNER_API_CORS_ORIGINS
cors_origins =
# Optional bearer token; required for non-loopback standalone API binding.
# Environment override: PROJECT_PLANNER_API_TOKEN
token =
# HTTP request/read timeout in seconds. Environment: PROJECT_PLANNER_API_TIMEOUT_SECONDS
timeout_seconds = 15
# Backup upload/download timeout in seconds. Environment: PROJECT_PLANNER_BACKUP_TIMEOUT_SECONDS
backup_timeout_seconds = 120
